#!/usr/bin/env bash
# metro-pipeline: run the metronome generator into pw-play, with the same
# process-group supervision contract as tuner-pipeline (started via setsid by
# the QML layer; the trap kills the full tree on close/error/reload).
#
# Usage: metro-pipeline <bpm> <beats-per-bar> <subdivision> [volume 0-100]
set -euo pipefail

[ $# -eq 3 ] || [ $# -eq 4 ] || { echo "usage: metro-pipeline <bpm> <beats> <subdivision> [volume]" >&2; exit 2; }
bpm=$1 beats=$2 sub=$3
vol=${4:-80}

[[ "$bpm" =~ ^[0-9]{1,3}$ && "$bpm" -ge 20 && "$bpm" -le 300 ]] || { echo "metro-pipeline: bad bpm" >&2; exit 2; }
[[ "$beats" =~ ^[0-9]{1,2}$ && "$beats" -ge 1 && "$beats" -le 12 ]] || { echo "metro-pipeline: bad beats" >&2; exit 2; }
case "$sub" in
  1/4|1/8|1/8t|1/16|1/16t|swing) ;;
  *) echo "metro-pipeline: bad subdivision" >&2; exit 2 ;;
esac
[[ "$vol" =~ ^[0-9]{1,3}$ && "$vol" -le 100 ]] || { echo "metro-pipeline: bad volume" >&2; exit 2; }
# pw-play wants a linear 0-1.0 factor.
vol_lin=$(awk -v v="$vol" 'BEGIN{printf "%.3f", v/100}')

command -v python3 >/dev/null 2>&1 || { echo '{"error":"missing python3"}' >&2; exit 127; }
command -v pw-play >/dev/null 2>&1 || { echo '{"error":"missing pw-play"}' >&2; exit 127; }
[ -x "${0%/*}/metronome" ] || { echo '{"error":"missing metronome generator"}' >&2; exit 127; }

# Single-flight: a crashed/reloaded shell can leave a detached setsid group
# clicking forever. Best-effort kill of stale siblings before starting.
if command -v ps >/dev/null 2>&1 && command -v awk >/dev/null 2>&1; then
  # shellcheck disable=SC2009
  stale=$(ps -eo pid,args | awk -v me=$$ -v s="$0" '$1 != me && $2 == "bash" && $3 == s {print $1}')
  if [ -n "$stale" ]; then
    # shellcheck disable=SC2086
    kill -TERM $stale 2>/dev/null || true
    sleep 0.2
  fi
fi

cleanup() {
  trap - TERM INT HUP EXIT
  kill -- -$$ 2>/dev/null || true
}
trap cleanup TERM INT HUP EXIT

# The pipeline must run in the background with a `wait`: bash defers
# trapped signals while blocked on a foreground pipeline, and since the
# metronome never exits, a TERM sent to this script would never run the
# trap (and never tear the group down). `wait` is interruptible, so the
# TERM trap fires immediately.
"${0%/*}/metronome" "$bpm" "$beats" "$sub" \
  | pw-play --raw --format=s16 --rate=44100 --channels=2 --latency=50ms --volume="$vol_lin" - &
wait
